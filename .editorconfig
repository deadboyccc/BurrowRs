root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{burrowrs,*.sh,*.bash,*.bats}]
indent_style = tab
shell_variant = bash

[*.py]
indent_style = space
indent_size = 4

[*.{yaml,yml,toml,json,html,css,svg}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
