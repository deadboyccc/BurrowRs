# burrowrs configuration reference.
#
# Don't copy this by hand: `./burrowrs init --domain notes.example.com` writes a
# real .env with a fresh secret. This file documents every setting and its
# default value (DOMAIN, which has no default, shows an example). After
# editing .env, apply it with `./burrowrs up`.
# Values are plain KEY=value. .env is parsed as data, never executed.

# --- Identity --------------------------------------------------------------
# stealth: your own domain + a real decoy website + a real TLS certificate.
#          Probes and browsers see an ordinary site. Recommended.
# simple:  no domain; impersonate COVER_DOMAIN. Works, but SNI and IP don't
#          match, which a careful censor can notice.
BURROWRS_MODE=stealth
# stealth: a domain whose A record points at this server. No domain? Your IP as a
# free wildcard-DNS name works too: 203-0-113-7.sslip.io (set LINK_HOST to the IP).
DOMAIN=notes.example.com
# simple: a popular HTTPS site that is reachable where your users are.
COVER_DOMAIN=
# Detected by `burrowrs init`. PUBLIC_IPV4 is used for links in simple mode and
# for the sponsored-channel route (AD_TAG). PUBLIC_IPV6 is informational.
PUBLIC_IPV4=
PUBLIC_IPV6=
# What links point at. Default: DOMAIN (stealth) or PUBLIC_IPV4 (simple).
# An IP keeps working even if the censor poisons DNS for your domain.
LINK_HOST=

# --- Access ----------------------------------------------------------------
# shared: one secret (SECRET) and one link for everyone. `burrowrs rotate`
#         replaces it, and every old link stops working.
# users:  every user gets a name and a secret of their own (`burrowrs user add`),
#         kept in users.tsv next to this file, with an expiry date, a data
#         quota and a device limit. SECRET stays yours: the built-in "owner"
#         user, which the health checks also use.
ACCESS_MODE=shared
# The owner's key: 16 random bytes as 32 hex characters. Links carry it as
# ee + key + hex(DOMAIN or COVER_DOMAIN). Generated by `burrowrs init`, replaced
# by `burrowrs rotate`.
SECRET=
# Defaults for `burrowrs user add` (each can be overridden per user):
#   days until expiry (1-36500, or never), the quota (none, or a size such as
#   50G in binary units), when it resets (none, daily, weekly or monthly; UTC)
#   and how many IP addresses may be connected at once (a number, or none).
USER_DEFAULT_DAYS=30
USER_DEFAULT_QUOTA=none
USER_DEFAULT_PERIOD=none
USER_DEFAULT_IPS=3
# Optional sponsored channel: the 32 hex characters @MTProxybot gives you.
# Routes traffic through Telegram's middle proxies; needs PUBLIC_IPV4.
AD_TAG=

# --- Network ---------------------------------------------------------------
BIND_ADDR=0.0.0.0
# The public port. 443 is what real HTTPS uses; anything else stands out.
PROXY_PORT=443
# stealth: Let's Encrypt HTTP-01 challenges and http->https redirects.
HTTP_PORT=80
# Prometheus metrics, published on 127.0.0.1 only.
METRICS_PORT=3129
# Also accept clients over IPv6 (dual-stack Docker network).
ENABLE_IPV6=false
# Private Docker network between telemt and the decoy. Change only on conflicts.
EDGE_SUBNET=10.204.47.0/28
DECOY_IP=10.204.47.10
EDGE_SUBNET6=fd42:7761:7272:656e::/64

# --- TLS for the decoy site (stealth mode) ---------------------------------
# acme: real certificate from Let's Encrypt. internal: self-signed (tests).
TLS_MODE=acme
ACME_EMAIL=
# e.g. https://acme-staging-v02.api.letsencrypt.org/directory while testing.
ACME_CA=

# --- Capacity --------------------------------------------------------------
# Maximum simultaneous client connections.
MAX_CONNECTIONS=10000
TELEMT_MEMORY_LIMIT=512m
DECOY_MEMORY_LIMIT=256m

# --- Observability ---------------------------------------------------------
# LOGGING=off keeps no container logs at all.
# LOG_LEVEL: silent = warnings and errors only. Successful connections are not
# logged, but refused ones are, with the user name and sometimes the client's
# IP (a disabled, expired or over-quota user; a replayed handshake).
# normal, verbose and debug log more. Links (secrets) are never logged.
LOGGING=on
LOG_LEVEL=silent
